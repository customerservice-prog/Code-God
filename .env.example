# All settings are optional. No paid services are required by the app.
CG_HOST=127.0.0.1
CG_PORT=4310
CG_PREVIEW_PORT=4311
# Local Ollama. Choose an installed tool-capable coding model in the UI.
CG_AI_PROVIDER=ollama
CG_AI_URL=http://127.0.0.1:11434
CG_MODEL=
# Alternative: compatible, with a server-side /v1 base URL and optional key.
# CG_AI_KEY=
# Optional GitHub token for private imports and creating pull requests.
# GITHUB_TOKEN=
# A fixed 32+ character token is required to bind beyond localhost.
# CG_AUTH_TOKEN=
# CG_DATA_DIR=/absolute/path/to/persistent/data
